  "structures": [
    {
      "id": "not-just",
      "regex": "(?i)\\bn[aã]o [ée] (?:s[oó]|apenas|somente) [^.!?\\n]{2,60}[,.] [ée]\\b",
      "name": "\"Não é só X, é Y\"",
      "fix": "Diga a única coisa que você quer dizer. Apaga a metade de preparação."
    },
    {
      "id": "not-only",
      "regex": "(?i)\\bn[aã]o (?:s[oó]|apenas|somente)\\b[^.!?\\n]{2,80}\\bmas tamb[ée]m\\b",
      "name": "\"Não só X, mas também Y\"",
      "fix": "Separa em duas frases, ou corta a metade mais fraca."
    },
    {
      "id": "isnt-about",
      "regex": "(?i)\\bn[aã]o [ée] sobre [^.!?\\n]{2,60}[.,!] [ée] sobre\\b",
      "name": "\"Não é sobre X. É sobre Y.\"",
      "fix": "Começa pelo Y. A inversão é a marca."
    },
    {
      "id": "the-result",
      "regex": "(?i)^\\s*(?:o resultado|a melhor parte|o detalhe|o pulo do gato|o segredo|e o resultado)\\?\\s*$",
      "name": "Linha de pergunta retórica de uma palavra",
      "fix": "Responde na mesma linha em vez de encenar a revelação."
    },
    {
      "id": "heres-what",
      "regex": "(?i)\\b(?:aqui est[aá]|isso [ée]|e) o que (?:eu|a gente) aprendi?(?:mos)?\\b",
      "name": "\"Aqui está o que eu aprendi\"",
      "fix": "Fala a lição. Pula o anúncio."
    },
    {
      "id": "triad",
      "regex": "(?i)\\b\\w+, \\w+ e \\w+\\.",
      "name": "Tríade (regra de três)",
      "fix": "Dois itens ou quatro. Três é o ritmo padrão do modelo."
    },
    {
      "id": "rocket",
      "regex": "[\\U0001F680\\U0001F525\\U0001F4A1\\u2728\\U0001F3AF]",
      "name": "Emoji de foguete / fogo / lâmpada / brilho / alvo",
      "fix": "Um emoji no máximo, e não um desses cinco."
    },
    {
      "id": "hashtag-wall",
      "regex": "(?:#\\w+[ \\t]*){6,}",
      "name": "Muro de hashtags (6+)",
      "fix": "Cinco no máximo. Desde dezembro de 2025 o Instagram só conta as cinco primeiras."
    },
    {
      "id": "as-an-ai",
      "regex": "(?i)\\bcomo (?:uma )?(?:ia|intelig[eê]ncia artificial)\\b|\\bcomo um modelo de linguagem\\b",
      "name": "IA falando de si mesma",
      "fix": "Apaga a frase."
    },
    {
      "id": "in-summary",
      "regex": "(?i)^\\s*(?:em suma|em resumo|resumindo|em conclus[aã]o|concluindo)\\b",
      "name": "Abertura de conclusão de redação",
      "fix": "Post não precisa de parágrafo de conclusão."
    },
    {
      "id": "engagement-bait",
      "regex": "(?i)(?:concorda\\?|concordam\\?|o que (?:voc[eê]s? )?acha(?:m)?\\?|quem mais\\b[^?\\n]*\\?|t[oô] errad[oa]\\?)\\s*$",
      "name": "Isca de engajamento no automático",
      "fix": "Faz uma pergunta que só você poderia fazer, sobre a coisa específica acima dela."
    },
    {
      "id": "stop-scroll",
      "regex": "(?im)^\\s*(?:para de rolar|n[aã]o passa|espera,? n[aã]o passa)\\b",
      "name": "Abertura \"para de rolar\"",
      "fix": "O que segura o dedo tem que ser a própria afirmação. Pedir atenção é sinal de que você ainda não ganhou ela."
    },
    {
      "id": "in-this-video",
      "regex": "(?i)\\b(?:n(?:esse|este|o) (?:v[ií]deo|reel|post)(?: de hoje)?|hoje (?:eu )?vou (?:te )?mostrar|vou (?:te )?(?:mostrar|ensinar) como)\\b",
      "name": "Introdução de vídeo (\"nesse vídeo eu vou te mostrar\")",
      "fix": "Apaga e começa no resultado. Os dois primeiros segundos decidem o reel inteiro."
    },
    {
      "id": "emoji-bullets",
      "regex": "(?m)^\\s*[\\U0001F300-\\U0001FAFF✅➡⬅✔✨]\\s*\\S",
      "name": "Lista com emoji de marcador",
      "fix": "Usa hífen ou quebra de linha. Emoji de marcador é a coisa com mais cara de template numa legenda."
    },
    {
      "id": "caps-shout",
      "regex": "\\b[A-ZÀ-Ý]{3,}\\b(?:\\s+\\b[A-ZÀ-Ý]{3,}\\b){2,}",
      "name": "Três ou mais palavras gritadas seguidas",
      "fix": "Caixa alta é botão de volume, não marca-texto. Uma palavra, no máximo."
    },
    {
      "id": "follow-bait",
      "regex": "(?i)\\b(?:(?:me )?segue pra mais|marca (?:aquele|aquela|um|uma) amig[oa]|deixa (?:seu|o) like|curte se|compartilha se|comenta aqui embaixo se)\\b",
      "name": "Pedido genérico de follow ou marcação",
      "fix": "Pede a única ação que esse post realmente merece. O pedido genérico ensina o público a ignorar todos os pedidos."
    },
    {
      "id": "gerundismo",
      "regex": "(?i)\\b(?:vou|vamos|vai|vão|vao) (?:estar|ficar) \\w+ndo\\b",
      "name": "Gerundismo (\"vou estar enviando\")",
      "fix": "Fala \"vou enviar\". Gerundismo soa telemarketing."
    }
  ]
}
